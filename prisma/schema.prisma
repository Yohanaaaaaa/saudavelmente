// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id           Int     @id @default(autoincrement())
  nomeCompleto String
  cpf          String  @unique
  email        String  @unique
  celular      String
  idade        Int?
  cidade       String?
  estado       String?
  senha        String?

  notificaEmail    Boolean @default(true)
  notificaWhatsapp Boolean @default(true)

  appointments Appointment[]
  reservas     Reserva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum TipoAtendimento {
  VOLUNTARIO
  SOCIAL
}

enum Modalidade {
  ONLINE
  PRESENCIAL
}

enum StatusCadastro {
  PENDENTE
  APROVADO
  REJEITADO
}

model Therapist {
  id                      Int             @id @default(autoincrement())
  nomeCompleto            String
  email                   String          @unique
  celular                 String
  tipo_atendimento        TipoAtendimento
  verificacao_registro    Boolean         @default(false)
  numero_registro         String
  horarioDisponivel       String
  abordagem_e_experiencia String
  pix                     String
  cpf                     String?         @unique

  // Perfil publico (catalogo e perfil completo)
  senha            String?
  slug             String?        @unique
  fotoUrl          String?
  bio              String?
  formacao         String?
  especialidades   String[]       @default([])
  idiomas          String[]       @default([])
  modalidades      Modalidade[]   @default([])
  experienciaAnos  Int?
  valorConsulta    Float?
  duracaoConsulta  Int            @default(50)
  cidade           String?
  estado           String?
  statusCadastro   StatusCadastro @default(PENDENTE)
  motivoRejeicao   String?
  ativo            Boolean        @default(true)

  notificaEmail    Boolean @default(true)
  notificaWhatsapp Boolean @default(true)

  appointments   Appointment[]
  availabilities TherapistAvailability[]
  reservas       Reserva[]
  payouts        Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Admin {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  createdAt DateTime @default(now())
}

enum AppointmentStatus {
  PENDENTE
  AGUARDANDO_PAGAMENTO
  APROVADO
  CONFIRMADO
  RECUSADO
  CANCELADO
  REMARCADO
  REALIZADO
  FALTA
}

model Appointment {
  id Int @id @default(autoincrement())

  descricao           String
  horario_atendimento DateTime
  data_atendimento    String
  status              AppointmentStatus @default(PENDENTE)
  modalidade          Modalidade        @default(ONLINE)
  valor               Float?
  duracaoMinutos      Int?
  expiresAt           DateTime?

  patientId   Int
  therapistId Int

  patient   Patient   @relation(fields: [patientId], references: [id])
  therapist Therapist @relation(fields: [therapistId], references: [id])

  availabilityId Int?
  availability   TherapistAvailability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  canceladoPor        String?
  canceladoEm         DateTime?
  motivoCancelamento  String?
  realizadoEm         DateTime?

  remarcadoDeId Int?         @unique
  remarcadoDe   Appointment? @relation("Remarcacao", fields: [remarcadoDeId], references: [id])
  remarcadoPara Appointment? @relation("Remarcacao")

  payment Payment?
  reserva Reserva?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([therapistId, horario_atendimento])
  @@index([patientId, horario_atendimento])
  @@index([status, expiresAt])
}

model TherapistAvailability {
  id          Int      @id @default(autoincrement())
  date        DateTime
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  therapistId Int

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  reservas     Reserva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([therapistId, date, startTime, endTime])
  @@index([therapistId, date])
  @@index([date, isAvailable])
}

enum ReservaStatus {
  ATIVA
  CONVERTIDA
  EXPIRADA
  CANCELADA
}

/// Reserva temporaria do horario, criada antes do cadastro do paciente.
/// Permite a jornada: escolher psicologo -> escolher horario -> cadastrar -> pagar.
model Reserva {
  id String @id @default(uuid())

  therapistId Int
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  availabilityId Int?
  availability   TherapistAvailability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  data_atendimento    String
  horario_atendimento DateTime
  duracaoMinutos      Int
  modalidade          Modalidade @default(ONLINE)
  valor               Float?

  status    ReservaStatus @default(ATIVA)
  expiresAt DateTime

  patientId Int?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  appointmentId Int?         @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([therapistId, horario_atendimento])
  @@index([status, expiresAt])
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

model Payment {
  id     Int           @id @default(autoincrement())
  valor  Float
  status PaymentStatus @default(PENDENTE)
  metodo String        @default("PIX")

  provedor           String  @default("appmax")
  externalOrderId    String?
  externalCustomerId String?
  qrCode             String?
  copiaECola         String?
  taxaPlataforma     Float?
  valorProfissional  Float?

  expiraEm DateTime?
  pagoEm   DateTime?

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  payout Payout?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([externalOrderId])
}

enum UsuarioTipo {
  PATIENT
  THERAPIST
  ADMIN
}

enum PayoutStatus {
  PENDENTE
  PAGO
  CANCELADO
}

/// Repasse do valor da consulta para o psicologo.
model Payout {
  id     Int          @id @default(autoincrement())
  valor  Float
  status PayoutStatus @default(PENDENTE)

  previsaoData DateTime
  pagoEm       DateTime?
  observacao   String?

  therapistId Int
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  paymentId Int     @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([therapistId, status])
}

enum NotificationTipo {
  AGENDAMENTO_CRIADO
  AGENDAMENTO_CONFIRMADO
  AGENDAMENTO_CANCELADO
  AGENDAMENTO_REMARCADO
  PAGAMENTO_CONFIRMADO
  CADASTRO_APROVADO
  CADASTRO_REJEITADO
  SUPORTE_ATUALIZADO
  SENHA_ALTERADA
}

/// Central de notificacoes de pacientes, psicologos e admins.
model Notification {
  id Int @id @default(autoincrement())

  destinatarioTipo UsuarioTipo
  destinatarioId   Int

  tipo      NotificationTipo
  titulo    String
  mensagem  String
  payload   Json?
  lida      Boolean   @default(false)
  lidaEm    DateTime?

  appointmentId Int?

  createdAt DateTime @default(now())

  @@index([destinatarioTipo, destinatarioId, lida])
  @@index([createdAt])
}

/// Token de recuperacao de senha (guardado como hash).
model PasswordResetToken {
  id Int @id @default(autoincrement())

  usuarioTipo UsuarioTipo
  usuarioId   Int
  email       String

  tokenHash String    @unique
  expiresAt DateTime
  usadoEm   DateTime?

  createdAt DateTime @default(now())

  @@index([usuarioTipo, usuarioId])
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

enum TicketPrioridade {
  BAIXA
  MEDIA
  ALTA
}

/// Central de suporte: chamados abertos por pacientes e psicologos.
model SupportTicket {
  id Int @id @default(autoincrement())

  assunto   String
  descricao String

  status     TicketStatus     @default(ABERTO)
  prioridade TicketPrioridade @default(MEDIA)

  solicitanteTipo UsuarioTipo
  solicitanteId   Int
  solicitanteNome String

  appointmentId Int?

  mensagens SupportMessage[]

  resolvidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([solicitanteTipo, solicitanteId])
}

model SupportMessage {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  autorTipo UsuarioTipo
  autorId   Int
  autorNome String
  mensagem  String
  interna   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
